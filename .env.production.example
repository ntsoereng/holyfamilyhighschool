# Holy Family High School production configuration for cPanel/Passenger.
# Copy to .env in the repository root and replace all placeholders.
# Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-of-at-least-50-characters
DJANGO_DEBUG=False
# Add only domain names that this deployment will serve.
DJANGO_ALLOWED_HOSTS=holyfamily.ac.ls,www.holyfamily.ac.ls
DJANGO_CSRF_TRUSTED_ORIGINS=https://holyfamily.ac.ls,https://www.holyfamily.ac.ls
DJANGO_LANGUAGE_CODE=en-gb
DJANGO_TIME_ZONE=Africa/Maseru
# Preferred public origin for canonical links, sharing previews and sitemap URLs.
SITE_URL=https://holyfamily.ac.ls

# Use the database and user names created in cPanel, including account prefixes.
# DATABASE_ENGINE=mysql or mariadb; both use the MYSQL_* credentials below.
# SQLite is available only with DJANGO_DEBUG=True.
DATABASE_ENGINE=mysql
MYSQL_DATABASE=cpanelaccount_holyfamily
MYSQL_USER=cpanelaccount_hfuser
MYSQL_PASSWORD=replace-with-the-mysql-user-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60
MYSQL_CONN_HEALTH_CHECKS=True

# Absolute paths inside this domain's document root; replace account and root.
DJANGO_STATIC_URL=/static/
DJANGO_STATIC_ROOT=/home/cpanelaccount/public_html/static
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=/home/cpanelaccount/public_html/media

DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Start with one hour; increase after confirming HTTPS works reliably.
DJANGO_SECURE_HSTS_SECONDS=3600
# Enable these only when all subdomains have permanent HTTPS support.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_USE_X_FORWARDED_HOST=False
# Enable only if the host sets and sanitises X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=False

# Passenger sends console logs to the application's stderr.log.
DJANGO_LOG_LEVEL=INFO

# Fallbacks before a School settings record exists.
# Day-to-day changes belong in Staff workspace > School settings.
CONTACT_EMAIL=holyfamilyhighschool56@gmail.com
CONTACT_PHONE=+266 2243 0282

# Development only: DJANGO_DEBUG=True and DATABASE_ENGINE=sqlite.
SQLITE_PATH=db.sqlite3

# Runtime settings (these match the defaults unless overridden).
# Memory limits are in bytes; session age is in seconds.
DJANGO_USE_I18N=True
DJANGO_USE_TZ=True
DJANGO_AXES_FAILURE_LIMIT=5
DJANGO_AXES_COOLOFF_MINUTES=30
DJANGO_AXES_RESET_ON_SUCCESS=True
DJANGO_PASSWORD_MIN_LENGTH=12
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_SESSION_COOKIE_HTTPONLY=True
DJANGO_CSRF_COOKIE_HTTPONLY=True
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_NUMBER_FILES=10
SQLITE_TIMEOUT=20
