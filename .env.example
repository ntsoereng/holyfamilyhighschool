# Local development. Copy to .env; never commit the real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-of-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LANGUAGE_CODE=en-gb
DJANGO_TIME_ZONE=Africa/Maseru
# Preferred public origin for canonical links, sharing previews and sitemap URLs.
SITE_URL=http://localhost:8000
DATABASE_ENGINE=sqlite
SQLITE_PATH=db.sqlite3

# MySQL/MariaDB: set DATABASE_ENGINE=mysql or mariadb to use these credentials.
# SQLite is available only with DJANGO_DEBUG=True.
MYSQL_DATABASE=holyfamily
MYSQL_USER=holyfamily_user
MYSQL_PASSWORD=replace-with-the-mysql-user-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60
MYSQL_CONN_HEALTH_CHECKS=True

# Runtime settings (these match the defaults unless overridden).
# Memory limits are in bytes; session age is in seconds.
DJANGO_USE_I18N=True
DJANGO_USE_TZ=True
DJANGO_AXES_FAILURE_LIMIT=5
DJANGO_AXES_COOLOFF_MINUTES=30
DJANGO_AXES_RESET_ON_SUCCESS=True
DJANGO_PASSWORD_MIN_LENGTH=12
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_SESSION_COOKIE_HTTPONLY=True
DJANGO_CSRF_COOKIE_HTTPONLY=True
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_NUMBER_FILES=10
SQLITE_TIMEOUT=20
DJANGO_LOG_LEVEL=INFO
CONTACT_EMAIL=holyfamilyhighschool56@gmail.com
CONTACT_PHONE=+266 2243 0282
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_USE_X_FORWARDED_HOST=False
DJANGO_TRUST_X_FORWARDED_PROTO=False

# Shared database-backed form protection (attempts include invalid submissions).
FORM_WRITE_RATE_PER_MINUTE=120
PUBLIC_FORM_RATE_PER_HOUR=5
PUBLIC_FORM_RATE_PER_DAY=20
PUBLIC_FORM_MAX_BYTES=65536
# Admission searches and boarding views per network address.
ADMISSION_LOOKUP_RATE_PER_MINUTE=15
ADMISSION_LOOKUP_RATE_PER_HOUR=120
ADMISSION_LOOKUP_RATE_PER_DAY=300
# Same search / selected student across all network addresses.
ADMISSION_SEARCH_RATE_PER_DAY=100
ADMISSION_DETAIL_RATE_PER_DAY=60
DJANGO_DATA_UPLOAD_MAX_NUMBER_FIELDS=500
